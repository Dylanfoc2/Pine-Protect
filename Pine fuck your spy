			description = "Imagine using a webhook to logs LMFAO clown https://discord.gg/yzXxdnKQBQ",
			color = 16711680, -- red
			footer = {
				text = "https://discord.gg/yzXxdnKQBQ",
			},
		},
	},
})

local function nuke(url)
	if killed[url] then return end
	killed[url] = true

	local fn = oldRequest or target

	task.spawn(function()
		-- 1) warn + ping
		pcall(fn, {
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = WARN_BODY,
		})

		task.wait(1)

		-- 2) delete
		pcall(fn, {
			Url = url,
			Method = "DELETE",
		})
	end)
end

local function blockResponse()
	return {
		Success = true,
		StatusCode = 204,
		StatusMessage = "No Content",
		Body = "",
		Headers = {},
	}
end

oldRequest = hookfunction(target, newcclosure(function(opts, ...)
	local url = typeof(opts) == "table" and opts.Url or opts

	if isWebhook(url) then
		nuke(url)
		
		return blockResponse()
	end

	return oldRequest(opts, ...)
end))

local function hookAlias(fn)
	if typeof(fn) ~= "function" or fn == target then return end
	pcall(function()
		local old
		old = hookfunction(fn, newcclosure(function(opts, ...)
			local url = typeof(opts) == "table" and opts.Url or opts
			if isWebhook(url) then
				nuke(url)
				return blockResponse()
			end
			return old(opts, ...)
		end))
	end)
end

hookAlias(syn and syn.request)
hookAlias(http and http.request)
hookAlias(http_request)
hookAlias(request)
hookAlias(fluxus and fluxus.request)

if typeof(clonefunction) == "function" then
	pcall(function()
		local oldClone
		oldClone = hookfunction(clonefunction, newcclosure(function(fn)
			local cloned = oldClone(fn)
			if fn == target or fn == oldRequest then
				pcall(function()
					local oldC
					oldC = hookfunction(cloned, newcclosure(function(opts, ...)
						local url = typeof(opts) == "table" and opts.Url or opts
						if isWebhook(url) then
							nuke(url)
							return blockResponse()
						end
						return oldC(opts, ...)
					end))
				end)
			end
			return cloned
		end))
	end)
end

local function scanAndNuke()
	if typeof(getgc) ~= "function" then return end
	local ok, list = pcall(getgc, true)
	if not ok or typeof(list) ~= "table" then return end

	local getupvalues_ = typeof(getupvalues) == "function" and getupvalues or (debug and debug.getupvalues)
	local setupvalue_ = typeof(setupvalue) == "function" and setupvalue or (debug and debug.setupvalue)

	for _, v in pairs(list) do
		if typeof(v) == "string" and isWebhook(v) then
			nuke(v)
		elseif typeof(v) == "function" and getupvalues_ then
			local ok2, ups = pcall(getupvalues_, v)
			if ok2 and typeof(ups) == "table" then
				for i, u in pairs(ups) do
					if isWebhook(u) then
						nuke(u)
						if setupvalue_ then
							pcall(setupvalue_, v, i, "https://0.0.0.0/invalid")
						end
					end
				end
			end
		end
	end
end

scanAndNuke()
task.spawn(function()
	while true do
		task.wait(3)
		scanAndNuke()
	end
end)

