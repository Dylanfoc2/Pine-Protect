local killed = {}

local function isWebhook(url)
	if typeof(url) ~= "string" then return false end
	url = string.lower(url)
	return string.find(url, "discord.com/api/webhooks", 1, true) ~= nil
		or string.find(url, "discordapp.com/api/webhooks", 1, true) ~= nil
end

local target = (syn and syn.request)
	or (http and http.request)
	or http_request
	or (fluxus and fluxus.request)
	or request

if typeof(target) ~= "function" or typeof(hookfunction) ~= "function" then
	warn("[anti-webhook] need request + hookfunction")
	return
end

local oldRequest

local WARN_BODY = game:GetService("HttpService"):JSONEncode({
	content = "@everyone",
	allowed_mentions = {
		parse = { "everyone", "roles", "users" },
	},
	embeds = {
		{
